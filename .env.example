TELEGRAM_TOKEN=your_telegram_bot_token
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.4-mini
OPENAI_REASONING_EFFORT=low
FEEDBACK_USERNAME=@your_username
ADMIN_TELEGRAM_ID=123456789
DATABASE_URL=postgresql://user:password@host:5432/database
WEB_SESSION_TTL_DAYS=30
WEB_PASSWORD_ITERATIONS=210000
WEB_OAUTH_FALLBACK_DOMAIN=oauth.local
PUBLIC_BASE_URL=https://your-railway-api-url.up.railway.app
GOOGLE_REDIRECT_URI=https://your-railway-api-url.up.railway.app/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FREE_DAILY_LIMIT=3
CACHE_TTL_DAYS=7
OPENINFO_EXCEL_PARSE_ENABLED=1
OPENINFO_EXCEL_MAX_REPORTS=3
OPENINFO_EXCEL_MAX_ANNUAL_REPORTS=1
OPENINFO_EXCEL_MAX_QUARTER_REPORTS=2
OPENINFO_EXCEL_ABSOLUTE_MAX_REPORTS=100
OPENINFO_REPORT_DOCUMENTS_PROMPT_LIMIT=100
OPENINFO_EXCEL_PROMPT_MAX_REPORTS=100
OPENINFO_EXCEL_PROMPT_MAX_SHEETS_PER_REPORT=3
OPENINFO_EXCEL_PROMPT_MAX_ROWS_PER_SHEET=8
OPENINFO_EXCEL_MAX_BYTES=3000000
OPENINFO_EXCEL_CACHE_TTL_DAYS=30
APP_MODE=bot
APP_DATA_DIR=./data
USERS_DB_PATH=users.db
CACHE_DB_PATH=analysis_cache.db
ORG_CACHE_PATH=org_cache.json
OUTPUT_PATH=report.html
CORS_ORIGINS=*

# --- §3.11 news module -------------------------------------------------------
# Generic LLM provider (OpenAI-compatible), used by Layer B's Tavily tool loop and as the
# fallback for the classifier. LLM_API_KEY is the generic key for any provider.
XAI_API_KEY=your_xai_api_key
LLM_API_KEY=
LLM_BASE_URL=https://api.x.ai/v1
LLM_MODEL=grok-4.3

# Layer-A classifier provider — OPTIONAL. Unset (the default) means Layer A classifies with
# the generic LLM_* provider above, i.e. Grok. Set these only to move the high-volume
# classification path to a cheaper provider; Layer-B search stays on Grok either way.
# With the three gates in place Grok costs ~$2.50-5/month, DeepSeek ~$0.25-0.60 — the swap
# buys a few dollars a month at the price of a second provider, key and bill.
# NEWS_CLASSIFIER_BASE_URL=https://api.deepseek.com
# NEWS_CLASSIFIER_MODEL=deepseek-v4-flash
# DEEPSEEK_API_KEY=
# NEWS_CLASSIFIER_API_KEY=      # only if the classifier key differs from DEEPSEEK_API_KEY
NEWS_TRIAGE_FLOOR=0.35          # score at/above which a borderline item still gets the full pass
NEWS_OG_MAX_FETCH=40            # cap on article-page fetches per run (card preview images)
# Cost logs use a built-in per-model price table; override it after a price change:
# LLM_PRICE_IN=   LLM_PRICE_OUT=   LLM_PRICE_CACHED=    ($ per 1M tokens)

# search_news() agent (Layer B). 'grok' = Grok native web+X search (no Tavily key
# needed, uses XAI_API_KEY). 'tavily' = provider-agnostic tool loop (needs TAVILY_API_KEY).
NEWS_SEARCH_BACKEND=grok
GROK_SEARCH_MODEL=grok-4.5
TAVILY_API_KEY=
NEWS_AGENT_MAX_ITERS=6

# Admin push (news collector -> prod). Shared secret; also used by the financials collector.
ADMIN_API_SECRET=your_admin_push_secret
NEWS_PUSH_URL=https://your-railway-api-url.up.railway.app
# openinfo material facts. Both optional — the adapter defaults to /disclosure/facts/ and a
# 2-page (~100 filings, ~5 days) lookback, which is what the enabled source uses.
# OPENINFO_FACTS_ENDPOINT=/disclosure/facts/
# OPENINFO_FACTS_PAGES=2
