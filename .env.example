TELEGRAM_TOKEN=your_telegram_bot_token
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.4-mini
OPENAI_REASONING_EFFORT=low
FEEDBACK_USERNAME=@your_username
ADMIN_TELEGRAM_ID=123456789
DATABASE_URL=postgresql://user:password@host:5432/database
WEB_SESSION_TTL_DAYS=30
WEB_PASSWORD_ITERATIONS=210000
WEB_OAUTH_FALLBACK_DOMAIN=oauth.local
PUBLIC_BASE_URL=https://your-railway-api-url.up.railway.app
GOOGLE_REDIRECT_URI=https://your-railway-api-url.up.railway.app/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FREE_DAILY_LIMIT=3
CACHE_TTL_DAYS=7
OPENINFO_EXCEL_PARSE_ENABLED=1
OPENINFO_EXCEL_MAX_REPORTS=3
OPENINFO_EXCEL_MAX_ANNUAL_REPORTS=1
OPENINFO_EXCEL_MAX_QUARTER_REPORTS=2
OPENINFO_EXCEL_ABSOLUTE_MAX_REPORTS=100
OPENINFO_REPORT_DOCUMENTS_PROMPT_LIMIT=100
OPENINFO_EXCEL_PROMPT_MAX_REPORTS=100
OPENINFO_EXCEL_PROMPT_MAX_SHEETS_PER_REPORT=3
OPENINFO_EXCEL_PROMPT_MAX_ROWS_PER_SHEET=8
OPENINFO_EXCEL_MAX_BYTES=3000000
OPENINFO_EXCEL_CACHE_TTL_DAYS=30
APP_MODE=bot
APP_DATA_DIR=./data
USERS_DB_PATH=users.db
CACHE_DB_PATH=analysis_cache.db
ORG_CACHE_PATH=org_cache.json
OUTPUT_PATH=report.html
CORS_ORIGINS=*

# --- §3.11 news module -------------------------------------------------------
# LLM provider (OpenAI-compatible). Configured for xAI/Grok; classification (Layer A).
# Confirm the exact fast model id in the xAI console (grok-4-fast / grok-4-1-fast /
# *-reasoning variants exist). LLM_API_KEY is the generic key for any provider.
XAI_API_KEY=your_xai_api_key
LLM_API_KEY=
LLM_BASE_URL=https://api.x.ai/v1
LLM_MODEL=grok-4-fast
# Alternative provider — DeepSeek (cheapest). To use it instead, set:
#   LLM_BASE_URL=https://api.deepseek.com   LLM_MODEL=deepseek-v4-flash   DEEPSEEK_API_KEY=...
# DEEPSEEK_API_KEY=

# search_news() agent (Layer B). 'grok' = Grok native web+X search (no Tavily key
# needed, uses XAI_API_KEY). 'tavily' = provider-agnostic tool loop (needs TAVILY_API_KEY).
NEWS_SEARCH_BACKEND=grok
GROK_SEARCH_MODEL=grok-4-1-fast
TAVILY_API_KEY=
NEWS_AGENT_MAX_ITERS=6

# Admin push (news collector -> prod). Shared secret; also used by the financials collector.
ADMIN_API_SECRET=your_admin_push_secret
NEWS_PUSH_URL=https://your-railway-api-url.up.railway.app
# openinfo material-facts endpoint path under the api base (enables the openinfo adapter).
OPENINFO_FACTS_ENDPOINT=
