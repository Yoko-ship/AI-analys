{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "cronSchedule": "0 3 * * 1-5",
    "startCommand": "/usr/local/bin/docker-entrypoint.sh python collector_financials.py",
    "restartPolicyType": "NEVER"
  }
}
