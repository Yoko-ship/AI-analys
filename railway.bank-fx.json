{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "cronSchedule": "10 6 * * *",
    "startCommand": "/usr/local/bin/docker-entrypoint.sh python collector_financials.py --bank-fx-only",
    "restartPolicyType": "NEVER"
  }
}
